rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Client-only app (no server): owners read and write their own records.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /diary/{linkId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Leaderboard: any signed-in user can read; you can only write your own row.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /pledges/{pledgeId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;

      match /days/{d} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/pledges/$(pledgeId)).data.uid == request.auth.uid;
      }

      match /acts/{a} {
        // Owner can list and write. A partner opens one exact link, so single reads are allowed
        // (the pledge id in the path is random and unguessable).
        allow list: if signedIn()
          && get(/databases/$(database)/documents/pledges/$(pledgeId)).data.uid == request.auth.uid;
        allow get: if signedIn();
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/pledges/$(pledgeId)).data.uid == request.auth.uid;
        // Partner answer: must carry the secret from the link, and only while a review is open.
        allow update: if signedIn()
          && resource.data.status in ['pending_partner', 'appealed']
          && request.resource.data.partnerKey == resource.data.partnerToken
          && request.resource.data.status in ['passed_by_partner', 'failed']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'partnerNote', 'partnerKey']);
      }
    }
  }
}
